# Copy the relevant values into each workspace's .env file:
#   server/.env
#   client/.env
#   adminpanel/.env
#
# Never commit real credentials. These are development-safe placeholders.

# ---------------------------------------------------------------------------
# Server (server/.env)
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Prisma resolves this relative to server/prisma/schema.prisma.
# The database lives at server/prisma/dev.db and is gitignored.
DATABASE_URL="file:./dev.db"

# Change this to a long random string outside local development.
JWT_SECRET=change-me-development-only

# Used when building password reset links.
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Optional email delivery (password reset emails).
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASS=

# Comma-separated allow-list. Leave empty to keep the original permissive CORS.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Customer storefront (client/.env)
# ---------------------------------------------------------------------------
REACT_APP_BASE_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Admin panel (adminpanel/.env)
# ---------------------------------------------------------------------------
REACT_APP_BASE_URL=http://localhost:5000
